# Copy to /matrix/sms-gateway/.env (chmod 600). Never commit the real file.
# Generated by scripts/gen_registration.py (must match registration.yaml):
SMSGW_AS_TOKEN=
SMSGW_HS_TOKEN=
# Telnyx Mission Control -> API Keys (the account that owns the 10DLC number):
TELNYX_API_KEY=
# Telnyx Mission Control -> API Keys -> Public Key (base64 Ed25519):
TELNYX_PUBLIC_KEY=
# Messaging profile the 10DLC number is attached to:
TELNYX_MESSAGING_PROFILE_ID=
# Only with the app login service (docs/LOGIN.md); same value in /matrix/sms-login/.env:
# SMSGW_INTERNAL_SECRET=
